<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MacMon" xmlns:chrome="using:Avalonia.Controls.Chrome" x:Class="MacMon.MainWindow" Icon="/Assets/MacMon.png" Title="{local:Loc &quot;MacMon&quot;}" Width="1000" Height="900" MinWidth="800" MinHeight="760" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="36">
  <Grid>
    <Border x:Name="TitleBackground" Height="36" VerticalAlignment="Top" Background="{DynamicResource MacChromeBrush}" IsHitTestVisible="False" />
    <local:CompactView x:Name="CompactPanel" IsVisible="False" />
    <Grid x:Name="MainLayout" Margin="20,0,20,8" RowSpacing="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="36" /><RowDefinition Height="1.15*" MinHeight="240" />
        <RowDefinition Height="6" /><RowDefinition Height="*" MinHeight="344" />
      </Grid.RowDefinitions>
      <Grid x:Name="TitleActions" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6" Background="{DynamicResource MacChromeBrush}" chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock Text="{local:Loc &quot;MacMon&quot;}" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="VersionLabel" Classes="label" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="OpenInfo" Content="{local:TitleButtonContent Info, Info}" AutomationProperties.Name="{local:Loc &quot;Info&quot;}" Classes="titleAction" ToolTip.Tip="{local:Loc &quot;About MacMon and hardware information&quot;}" />
        <Button Grid.Column="2" x:Name="OpenSettings" Content="{local:TitleButtonContent Settings, Settings}" AutomationProperties.Name="{local:Loc &quot;Settings&quot;}" Classes="titleAction" ToolTip.Tip="{local:Loc &quot;Settings (⌘,)&quot;}" />
        <Button Grid.Column="3" x:Name="OpenExport" Content="{local:TitleButtonContent Download, Export}" AutomationProperties.Name="{local:Loc &quot;Export&quot;}" Classes="titleAction" />
        <Button Grid.Column="5" x:Name="EnterCompactView" Content="{local:TitleButtonContent Compact, Compact view}" AutomationProperties.Name="{local:Loc &quot;Compact view&quot;}" Classes="titleAction" ToolTip.Tip="{local:Loc &quot;Compact view (⌘⇧M)&quot;}" />
        <ToggleButton Grid.Column="6" x:Name="AlwaysOnTop" Content="{local:TitleButtonContent AlwaysOnTop, Always on top}" AutomationProperties.Name="{local:Loc &quot;Always on top&quot;}" Classes="titleAction" ToolTip.Tip="{local:Loc &quot;Keep MacMon above other windows&quot;}" />
      </Grid>
      <Grid Grid.Row="1" RowDefinitions="98,Auto,*" RowSpacing="8">
        <UniformGrid x:Name="ResourceCards" Columns="5">
          <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,0"><local:ResourceGauge x:Name="CpuGauge" Title="CPU" Fill="{DynamicResource CpuStroke}" TextAccent="{DynamicResource CpuText}" /></Border>
          <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,0"><local:ResourceGauge x:Name="MemoryGauge" Title="Memory" Fill="{DynamicResource MemoryStroke}" TextAccent="{DynamicResource MemoryText}" /></Border>
          <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,0"><local:ResourceGauge x:Name="StorageGauge" Title="Disk" Fill="{DynamicResource StorageStroke}" TextAccent="{DynamicResource StorageText}" /></Border>
          <Border x:Name="SecondDiskCard" IsVisible="False" BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,0"><local:ResourceGauge x:Name="SecondDiskGauge" Title="Disk 2" Fill="{DynamicResource SecondDiskStroke}" TextAccent="{DynamicResource SecondDiskText}" /></Border>
          <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,0"><local:ResourceGauge x:Name="NetworkGauge" Title="Network" Fill="{DynamicResource NetworkStroke}" TextAccent="{DynamicResource NetworkText}" /></Border>
          <Border Padding="5,0"><local:ResourceGauge x:Name="GpuGauge" Title="GPU" Fill="{DynamicResource GpuStroke}" TextAccent="{DynamicResource GpuText}" /></Border>
        </UniformGrid>
        <Border Grid.Row="1" Classes="sectionHeader" Padding="20,5">
          <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{local:Loc &quot;System&quot;}" Classes="toolbarLabel" />
              <ComboBox x:Name="ChartModeBox" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="{local:Loc &quot;Chart layout or focus metric&quot;}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
              <Button x:Name="LiveMode" local:ButtonIcon.Kind="Start" Content="{local:Loc &quot;● Live&quot;}" Classes="chip" /><Button x:Name="CaptureMode" local:ButtonIcon.Kind="Capture" Content="{local:Loc &quot;◎ Capture&quot;}" Classes="chip" />
            </StackPanel>
            <Grid Grid.Column="2">
              <Button HorizontalAlignment="Left" x:Name="AutomaticCaptures" local:ButtonIcon.Kind="AutomaticCapture" Content="{local:Loc &quot;Auto&quot;}" Classes="titleAction" ToolTip.Tip="{local:Loc &quot;Automatic captures and saved reports&quot;}">
                <Button.Flyout><Flyout Placement="Bottom">
                  <StackPanel Spacing="8" Width="360">
                    <Button x:Name="ConfigureCaptures" local:ButtonIcon.Kind="Settings" Content="{local:Loc &quot;Automatic capture settings…&quot;}" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="CapturesList" PlaceholderText="{local:Loc &quot;Saved automatic captures&quot;}" AutomationProperties.Name="{local:Loc &quot;Automatic captures&quot;}" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="OpenCaptureReport" local:ButtonIcon.Kind="Folder" Content="{local:Loc &quot;Open report&quot;}" IsEnabled="False" /><Button x:Name="CopyCapture" local:ButtonIcon.Kind="Copy" Content="{local:Loc &quot;Copy capture&quot;}" /></StackPanel>
                    <TextBlock x:Name="CaptureStatus" Classes="label" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Flyout></Button.Flyout>
              </Button>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                <RadioButton x:Name="Range2" Content="{local:Loc &quot;2m&quot;}" GroupName="HistoryRange" Classes="chip" IsChecked="True" AutomationProperties.Name="{local:Loc &quot;2 minute history&quot;}" />
                <RadioButton x:Name="Range10" Content="{local:Loc &quot;10m&quot;}" GroupName="HistoryRange" Classes="chip" AutomationProperties.Name="{local:Loc &quot;10 minute history&quot;}" />
                <RadioButton x:Name="Range30" Content="{local:Loc &quot;30m&quot;}" GroupName="HistoryRange" Classes="chip" AutomationProperties.Name="{local:Loc &quot;30 minute history&quot;}" />
                <RadioButton x:Name="Range60" Content="{local:Loc &quot;60m&quot;}" GroupName="HistoryRange" Classes="chip" AutomationProperties.Name="{local:Loc &quot;60 minute history&quot;}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <local:CpuChart Grid.Row="2" x:Name="Chart" MinHeight="80" AutomationProperties.Name="{local:Loc &quot;Resource history&quot;}" />
      </Grid>
      <GridSplitter x:Name="ChartProcessDivider" Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Focusable="True" Cursor="SizeNorthSouth" AutomationProperties.Name="{local:Loc &quot;Resize dashboard and data panes&quot;}">
        <GridSplitter.Template><ControlTemplate><Grid Background="Transparent">
          <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource MacGridBrush}" />
          <Border x:Name="DividerGrip" Width="32" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="1.5" Background="{DynamicResource MacMutedBrush}" />
        </Grid></ControlTemplate></GridSplitter.Template>
      </GridSplitter>
      <Grid Grid.Row="3">
        <Border x:Name="TabBarBackground" Height="34" VerticalAlignment="Top" Margin="-20,0" Background="{DynamicResource MacHeaderBrush}" IsHitTestVisible="False" />
        <TabControl x:Name="DataTabs" ClipToBounds="False">
          <TabItem Header="{local:Loc &quot;Processes&quot;}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="4">
              <Border Classes="sectionHeader">
                <local:TableToolbarLayout>
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,8,4">
                    <TextBlock Text="{local:Loc &quot;Top&quot;}" Classes="toolbarLabel" /><ComboBox x:Name="ProcessLimitBox" Width="54" Classes="rankingChoice" AutomationProperties.Name="{local:Loc &quot;Process row limit&quot;}" ToolTip.Tip="{local:Loc &quot;Maximum unpinned rows; matching pins remain visible&quot;}" />
                    <TextBlock Text="{local:Loc &quot;processes by&quot;}" Classes="toolbarLabel" /><ComboBox x:Name="ProcessSortBox" Width="96" Classes="rankingChoice" SelectedIndex="0" AutomationProperties.Name="{local:Loc &quot;Sort processes&quot;}"></ComboBox>
                  </StackPanel>
                  <TextBox x:Name="ProcessSearchBox" MinWidth="80" PlaceholderText="{local:Loc &quot;Search name or PID&quot;}" AutomationProperties.Name="{local:Loc &quot;Search processes&quot;}" Margin="0,0,8,4" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="ProcessAppsOnly" Content="{local:Loc &quot;App only&quot;}" FontSize="12" Margin="0,0,8,4" ToolTip.Tip="{local:Loc &quot;Executables inside .app bundles, including helpers and background apps&quot;}" />
                    <CheckBox x:Name="PinnedOnly" Content="{local:Loc &quot;Pinned only&quot;}" FontSize="12" Margin="0,0,8,4" />
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,0,4"><RadioButton x:Name="IndividualProcesses" Content="{local:Loc &quot;Individual&quot;}" GroupName="ProcessGrouping" Classes="chip" IsChecked="True" /><RadioButton x:Name="GroupProcesses" Content="{local:Loc &quot;Grouped&quot;}" GroupName="ProcessGrouping" Classes="chip" /></StackPanel>
                  </StackPanel>
                </local:TableToolbarLayout>
              </Border>
              <Grid Grid.Row="1" ColumnDefinitions="28,*,140,65,100,90,60" Margin="6,0,18,0">
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ProcessNameHeader" Content="{local:Loc &quot;Process&quot;}" Classes="tableHeader" Tag="4" Click="OnProcessHeaderClick" /><Button x:Name="ProcessPidHeader" Content="{local:Loc &quot;PID&quot;}" IsVisible="False" Classes="tableHeader" Tag="5" Click="OnProcessHeaderClick" /></StackPanel>
                <TextBlock Grid.Column="2" Text="{local:Loc &quot;History&quot;}" Classes="columnLabel" HorizontalAlignment="Center" />
                <Button Grid.Column="3" x:Name="ProcessCpuHeader" Content="{local:Loc &quot;CPU&quot;}" Classes="tableHeader numericHeader" Tag="0" Click="OnProcessHeaderClick" />
                <Button Grid.Column="4" x:Name="ResidentHeader" Content="{local:Loc &quot;Memory&quot;}" Classes="tableHeader numericHeader" Tag="1" Click="OnProcessHeaderClick" />
                <Button Grid.Column="5" x:Name="ProcessIoHeader" Content="{local:Loc &quot;I/O&quot;}" Classes="tableHeader numericHeader" Tag="3" Click="OnProcessHeaderClick" />
                <Button Grid.Column="6" x:Name="ProcessThreadsHeader" Content="{local:Loc &quot;Threads&quot;}" Classes="tableHeader numericHeader" Tag="2" Click="OnProcessHeaderClick" />
                <TextBlock Grid.Column="0" Text="{local:Loc &quot;Pin&quot;}" Classes="columnLabel" />
              </Grid>
              <Grid Grid.Row="2">
                <ListBox x:Name="ProcessList" Classes="dataRows" AutoScrollToSelectedItem="False" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{local:Loc &quot;Observed processes&quot;}">
                  <ListBox.ItemTemplate><DataTemplate x:DataType="local:ProcessRow">
                    <Border Classes="dataRow" ContextRequested="OnProcessContextRequested"><Grid ColumnDefinitions="28,*,140,65,100,90,60" ColumnSpacing="0" ToolTip.Tip="{Binding Path}">
                      <Grid Grid.Column="1" ColumnDefinitions="20,*" ColumnSpacing="5"><Image Source="{Binding Icon}" Width="16" Height="16" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Pid}" Classes="label" FontSize="10" /></StackPanel></Grid>
                      <local:ProcessSparkline Grid.Column="2" Trail="{Binding Trail}" Height="24" Margin="6,0" />
                      <TextBlock Grid.Column="3" Text="{Binding Cpu}" Classes="cpuMetric" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="{Binding Resident}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="5" Text="{Binding Io}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="6" Text="{Binding Threads}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      <Button Grid.Column="0" Content="{Binding PinAction}" IsEnabled="{Binding CanPin}" Click="OnRowPinClick" Classes="rowPin" AutomationProperties.Name="{Binding PinActionName}" ToolTip.Tip="{Binding PinActionName}" />
                    </Grid></Border>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyProcessLabel" Text="{local:Loc &quot;Waiting for process readings…&quot;}" Classes="label" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
              </Grid>
<Border Grid.Row="3" Classes="actionBar" Classes.collapsed="{Binding !IsChecked, ElementName=ShowProcessActions}"><Grid ColumnDefinitions="4,*,Auto">
                <Border Background="{DynamicResource CpuStroke}" CornerRadius="3,0,0,3" />
                <local:ActionBarLayout Grid.Column="1" Margin="14,6,6,6">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Image x:Name="SelectionIcon" Width="28" Height="28" IsVisible="False" />
                    <StackPanel Grid.Column="1" Spacing="2"><Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                      <TextBlock x:Name="ProcessSelectionName" Text="{local:Loc &quot;Select a process&quot;}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" x:Name="ProcessSelectionStatus" IsVisible="False" BorderThickness="1" BorderBrush="{DynamicResource MacGridBrush}" CornerRadius="4" Padding="7,3" Margin="10,0,0,0"><TextBlock x:Name="ProcessSelectionStatusText" FontSize="11" /></Border>
                    </Grid><TextBlock x:Name="SelectionLabel" IsVisible="{Binding IsChecked, ElementName=ShowProcessActions}" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                  </Grid>
                  <WrapPanel Grid.Column="1" x:Name="ProcessActionsPanel" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="False">
                    <Button x:Name="ShowProperties" local:ButtonIcon.Kind="Info" Content="{local:Loc &quot;Properties&quot;}" /><Button x:Name="CopyProcessDetails" local:ButtonIcon.Kind="Copy" Content="{local:Loc &quot;Copy details&quot;}" />
                    <Button x:Name="MoreProcessActions" local:ButtonIcon.Kind="More" Content="{local:Loc &quot;More…&quot;}"><Button.Flyout><Flyout Placement="Top"><StackPanel Spacing="6"><Button x:Name="PinSelection" local:ButtonIcon.Kind="Pin" Content="{local:Loc &quot;Pin selected&quot;}" /><Button x:Name="RevealExecutable" local:ButtonIcon.Kind="Folder" Content="{local:Loc &quot;Reveal in Finder&quot;}" /></StackPanel></Flyout></Button.Flyout></Button>
                    <Border Classes="actionDivider" /><Button x:Name="EndProcess" local:ButtonIcon.Kind="Cancel" Content="{local:Loc &quot;End process…&quot;}" Classes="dangerAction" />
                  </WrapPanel>
                </local:ActionBarLayout>
                <ToggleButton Grid.Column="2" x:Name="ShowProcessActions" local:ButtonIcon.Kind="ChevronDown" IsChecked="True" Classes="actionCollapse" AutomationProperties.Name="{local:Loc &quot;Show or hide actions&quot;}" ToolTip.Tip="{local:Loc &quot;Show or hide actions&quot;}" />
              </Grid></Border>
            </Grid>
          </TabItem>
          <TabItem Header="{local:Loc &quot;Jobs&quot;}"><local:LaunchdView x:Name="JobsView" /></TabItem>
          <TabItem Header="{local:Loc &quot;Usage&quot;}">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="4">
              <Border Classes="sectionHeader"><local:TableToolbarLayout>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,8,4"><TextBlock Text="{local:Loc &quot;Top&quot;}" Classes="toolbarLabel" /><ComboBox x:Name="UsageLimitBox" Width="54" Classes="rankingChoice" AutomationProperties.Name="{local:Loc &quot;Usage row limit&quot;}" /><TextBlock Text="{local:Loc &quot;apps by&quot;}" Classes="toolbarLabel" /><ComboBox x:Name="UsageSortBox" Width="96" Classes="rankingChoice" SelectedIndex="0" AutomationProperties.Name="{local:Loc &quot;Sort usage&quot;}"></ComboBox></StackPanel>
                <TextBox x:Name="UsageSearch" MinWidth="140" PlaceholderText="{local:Loc &quot;Search name or path&quot;}" AutomationProperties.Name="{local:Loc &quot;Search usage&quot;}" Margin="0,0,8,4" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <CheckBox x:Name="UsageAppsOnly" Content="{local:Loc &quot;App only&quot;}" FontSize="12" Margin="0,0,8,4" ToolTip.Tip="{local:Loc &quot;Executables inside .app bundles, including helpers and exited apps&quot;}" />
                  <Button x:Name="CopyUsage" local:ButtonIcon.Kind="Copy" Content="{local:Loc &quot;Copy usage&quot;}" Margin="0,0,6,4" /><Button x:Name="ResetUsage" local:ButtonIcon.Kind="Live" Content="{local:Loc &quot;Reset&quot;}" Margin="0,0,0,4" />
                </StackPanel>
              </local:TableToolbarLayout></Border>
              <Grid Grid.Row="1" ColumnDefinitions="*,80,64,84,78,84" Margin="6,0,18,0">
                <Button x:Name="UsageNameHeader" Content="{local:Loc &quot;App&quot;}" Classes="tableHeader" Tag="3" Click="OnUsageHeaderClick" /><Button Grid.Column="1" x:Name="UsageCpuHeader" Content="{local:Loc &quot;CPU time&quot;}" Classes="tableHeader numericHeader" Tag="0" Click="OnUsageHeaderClick" /><Button Grid.Column="2" x:Name="UsageShareHeader" Content="{local:Loc &quot;Share&quot;}" Classes="tableHeader numericHeader" Tag="4" Click="OnUsageHeaderClick" /><Button Grid.Column="3" x:Name="UsageIoHeader" Content="{local:Loc &quot;I/O&quot;}" Classes="tableHeader numericHeader" Tag="1" Click="OnUsageHeaderClick" /><Button Grid.Column="4" x:Name="UsageProcessesHeader" Content="{local:Loc &quot;Processes&quot;}" Classes="tableHeader numericHeader" Tag="5" Click="OnUsageHeaderClick" /><Button Grid.Column="5" x:Name="UsageLastHeader" Content="{local:Loc &quot;Last active&quot;}" Classes="tableHeader numericHeader" Tag="2" Click="OnUsageHeaderClick" />
              </Grid>
              <ListBox Grid.Row="2" x:Name="UsageList" Classes="dataRows" AutoScrollToSelectedItem="False" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{local:Loc &quot;Session usage totals&quot;}">
                <ListBox.ItemTemplate><DataTemplate x:DataType="local:UsageRow"><Border Classes="dataRow" ContextRequested="OnUsageContextRequested"><Grid ColumnDefinitions="*,80,64,84,78,84" ToolTip.Tip="{Binding Path}">
                  <Grid ColumnDefinitions="20,*" ColumnSpacing="5"><Image Source="{Binding Icon}" Width="16" Height="16" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" Classes="label" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel></Grid>
                  <TextBlock Grid.Column="1" Text="{Binding Cpu}" Classes="cpuMetric" VerticalAlignment="Center" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" Text="{Binding Share}" VerticalAlignment="Center" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding DiskIo}" VerticalAlignment="Center" HorizontalAlignment="Right" /><TextBlock Grid.Column="4" Text="{Binding Processes}" VerticalAlignment="Center" HorizontalAlignment="Right" /><TextBlock Grid.Column="5" Text="{Binding LastActive}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid></Border></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
<Border Grid.Row="3" BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,1,0,0" Padding="6,6,18,6" ToolTip.Tip="{local:Loc &quot;Machine busy CPU time not assigned to observed apps. This session total is unaffected by table filters; missing intervals are excluded.&quot;}">
                <Grid ColumnDefinitions="*,80,64,84,78,84"><TextBlock Text="{local:Loc &quot;Not attributed&quot;}" Classes="label" /><TextBlock Grid.Column="1" x:Name="UnattributedCpu" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" x:Name="UnattributedShare" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="—" HorizontalAlignment="Right" /><TextBlock Grid.Column="4" Text="—" HorizontalAlignment="Right" /><TextBlock Grid.Column="5" Text="—" HorizontalAlignment="Right" /></Grid>
              </Border>
<Border Grid.Row="4" Classes="actionBar" Classes.collapsed="{Binding !IsChecked, ElementName=ShowUsageActions}"><Grid ColumnDefinitions="4,*,Auto">
                <Border Background="{DynamicResource CpuStroke}" CornerRadius="3,0,0,3" />
                <local:ActionBarLayout Grid.Column="1" Margin="14,6,6,6">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center" Margin="0,0,12,0"><Image x:Name="UsageSelectionIcon" Width="28" Height="28" IsVisible="False" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="UsageSelectionName" Text="{local:Loc &quot;Select an app&quot;}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="UsageSelection" IsVisible="{Binding IsChecked, ElementName=ShowUsageActions}" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel></Grid>
                  <WrapPanel x:Name="UsageActionsPanel" Grid.Column="1" HorizontalAlignment="Right" ItemsAlignment="End" VerticalAlignment="Center" IsVisible="{Binding IsChecked, ElementName=ShowUsageActions}"><Button x:Name="UsageProperties" local:ButtonIcon.Kind="Info" Content="{local:Loc &quot;Properties&quot;}" IsEnabled="False" /><Button x:Name="CopyUsageApp" local:ButtonIcon.Kind="Copy" Content="{local:Loc &quot;Copy details&quot;}" IsEnabled="False" /><Button x:Name="UsageShowProcesses" local:ButtonIcon.Kind="Process" Content="{local:Loc &quot;Show in Processes&quot;}" IsEnabled="False" /><Button x:Name="RevealUsageApp" Margin="0" local:ButtonIcon.Kind="Folder" Content="{local:Loc &quot;Reveal in Finder&quot;}" IsEnabled="False" /></WrapPanel>
                </local:ActionBarLayout>
                <ToggleButton Grid.Column="2" x:Name="ShowUsageActions" local:ButtonIcon.Kind="ChevronDown" IsChecked="True" Classes="actionCollapse" AutomationProperties.Name="{local:Loc &quot;Show or hide actions&quot;}" ToolTip.Tip="{local:Loc &quot;Show or hide actions&quot;}" />
              </Grid></Border>
            </Grid>
          </TabItem>
        </TabControl>
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Height="34" MaxWidth="440" Margin="240,0,4,0">
          <TextBlock x:Name="ProcessCountLabel" TextAlignment="Right" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock x:Name="JobSummary" TextAlignment="Right" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="False" />
          <TextBlock x:Name="UsageStatus" TextAlignment="Right" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="False" />
        </Grid>
      </Grid>
      <TextBlock IsVisible="False" x:Name="StatusLabel" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</Window>
