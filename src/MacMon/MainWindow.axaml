<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MacMon"
        x:Class="MacMon.MainWindow" Title="MacMon" Width="1000" Height="1000"
        MinWidth="800" MinHeight="760" Background="#0E1721">
  <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,240,*,Auto" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="MacMon" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="A live view of your Mac" Classes="label" />
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="MachineLabel" Classes="label" VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="CPU · machine capacity" Classes="label" />
          <TextBlock x:Name="CpuValue" Text="—" FontSize="32" Foreground="#6DE3CB" />
          <TextBlock x:Name="KernelValue" Text="Establishing baseline…" Classes="label" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Memory · physical usage estimate" Classes="label" />
          <TextBlock x:Name="MemoryValue" Text="—" FontSize="32" />
          <TextBlock x:Name="MemoryDetails" Text="Reading memory…" Classes="label" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Data volume · available" Classes="label" />
          <TextBlock x:Name="DiskValue" Text="—" FontSize="32" />
          <TextBlock x:Name="DiskTotal" Text="Reading capacity…" Classes="label" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
      <Border Classes="card" Padding="14">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="5">
          <TextBlock Text="Network" Classes="label" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" x:Name="NetworkAdapter" AutomationProperties.Name="Network interface" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="NetworkValue" Text="↓ — · ↑ —" TextWrapping="Wrap" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="card" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="Storage activity · all block-storage drivers" Classes="label" />
          <TextBlock x:Name="StorageValue" Text="Read — · write —" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Classes="card">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Resource history" FontSize="18" FontWeight="SemiBold" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="0–100%" Classes="label" VerticalAlignment="Center" />
            <ComboBox x:Name="HistoryRange" SelectedIndex="0" AutomationProperties.Name="History range">
              <ComboBoxItem Content="2 minutes" />
              <ComboBoxItem Content="10 minutes" />
              <ComboBoxItem Content="30 minutes" />
              <ComboBoxItem Content="60 minutes" />
            </ComboBox>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
          <Grid RowDefinitions="Auto,*" RowSpacing="6">
            <TextBlock Text="CPU teal · memory purple · 0–100%" Classes="label" FontSize="12" />
            <local:CpuChart Grid.Row="1" x:Name="Chart" />
          </Grid>
          <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">
            <TextBlock x:Name="ActivityScale" Text="Network blue · storage gold · auto scale" Classes="label" FontSize="12" />
            <local:CpuChart Grid.Row="1" x:Name="ActivityChart" ShowActivity="True" />
          </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="6">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button x:Name="LiveMode" Content="Live" />
            <Button Grid.Column="1" x:Name="CaptureMode" Content="Capture" />
            <TextBlock Grid.Column="2" Text="Click either chart to inspect" Classes="label" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
            <Button Grid.Column="3" x:Name="ExportResources" Content="Export resources" />
            <Button Grid.Column="4" x:Name="ExportProcesses" Content="Export processes" />
          </Grid>
          <TextBlock x:Name="CaptureStatus" Text="Live · recording" Classes="label" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="4" Classes="card">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,240,160" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Processes" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="ProcessCountLabel" Text="Establishing baselines…" Classes="label" FontSize="12" />
          </StackPanel>
          <TextBox Grid.Column="1" x:Name="ProcessSearchBox" PlaceholderText="Search name or PID"
                   AutomationProperties.Name="Search processes" VerticalAlignment="Center" />
          <ComboBox Grid.Column="2" x:Name="ProcessSortBox" SelectedIndex="0"
                    AutomationProperties.Name="Sort processes" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <ComboBoxItem Content="CPU usage" />
            <ComboBoxItem Content="Resident memory" />
            <ComboBoxItem Content="Threads" />
            <ComboBoxItem Content="Disk I/O" />
          </ComboBox>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
          <CheckBox x:Name="GroupProcesses" Content="Grouped" />
          <CheckBox x:Name="PinnedOnly" Content="Pinned only" />
          <Button x:Name="PinSelection" Content="Pin selected" IsEnabled="False" />
          <TextBlock Text="30s trend · selected metric · local scale" Classes="label" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,80,100,120,80,100,90" Margin="10,0,10,0">
          <TextBlock Text="Name" Classes="label" />
          <TextBlock Grid.Column="1" Text="PID" Classes="label" />
          <TextBlock Grid.Column="2" Text="CPU · avg 5s" Classes="label" />
          <TextBlock Grid.Column="3" x:Name="ResidentHeader" Text="Resident" Classes="label" />
          <TextBlock Grid.Column="4" Text="Threads" Classes="label" />
          <TextBlock Grid.Column="5" Text="Disk I/O · 5s" Classes="label" />
          <TextBlock Grid.Column="6" Text="Trend" Classes="label" />
        </Grid>
        <Grid Grid.Row="3">
          <ListBox x:Name="ProcessList" Background="Transparent" BorderThickness="0"
                   AutomationProperties.Name="Observed processes">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:ProcessRow">
                <Grid ColumnDefinitions="*,80,100,120,80,100,90" Margin="0,3" ToolTip.Tip="{Binding Path}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <TextBlock Text="{Binding Pin}" Foreground="#BD9AFF" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <TextBlock Grid.Column="1" Text="{Binding Pid}" />
                  <TextBlock Grid.Column="2" Text="{Binding Cpu}" Foreground="#6DE3CB" />
                  <TextBlock Grid.Column="3" Text="{Binding Resident}" />
                  <TextBlock Grid.Column="4" Text="{Binding Threads}" />
                  <TextBlock Grid.Column="5" Text="{Binding Io}" />
                  <local:ProcessSparkline Grid.Column="6" Trail="{Binding Trail}" Height="20" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyProcessLabel" Text="Waiting for process readings…" Classes="label"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <TextBlock Grid.Row="4" x:Name="SelectionLabel" Text="Select a process to inspect its lifetime and path."
                   Classes="label" FontSize="12" TextWrapping="Wrap" MaxHeight="65" />
      </Grid>
    </Border>
    <StackPanel Grid.Row="5" Spacing="6">
      <TextBlock x:Name="StatusLabel" Text="Starting native collector…" Classes="label" TextWrapping="Wrap" />
      <TextBlock Text="CPU is a share of total machine capacity · — means unavailable · resident memory includes shared pages"
                 Classes="label" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
