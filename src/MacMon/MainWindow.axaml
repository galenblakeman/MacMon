<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MacMon"
        x:Class="MacMon.MainWindow" Title="MacMon" Width="1000" Height="900"
        MinWidth="800" MinHeight="760">
  <Grid>
  <local:CompactView x:Name="CompactPanel" IsVisible="False" />
  <Grid x:Name="MainLayout" Margin="16" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="120" />
      <RowDefinition Height="6" />
      <RowDefinition Height="*" MinHeight="300" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinHeight="32">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="MacMon" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionLabel" Classes="label" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="MachineLabel" Classes="label" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <CheckBox x:Name="AlwaysOnTop" Content="Always on top" FontSize="12" />
        <Button x:Name="EnterCompactView" Content="Compact" ToolTip.Tip="Compact view (⌘⇧M)" />
        <Button x:Name="OpenSettings" Content="Settings…" ToolTip.Tip="Settings (⌘,)" />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8" Margin="0,0,4,0">
    <UniformGrid x:Name="ResourceCards" Grid.Row="0" Columns="4">
      <Border Classes="card" Padding="8" Margin="0,0,8,8"><local:ResourceGauge x:Name="CpuGauge" Title="CPU" Fill="{DynamicResource CpuStroke}" /></Border>
      <Border Classes="card" Padding="8" Margin="0,0,8,8"><local:ResourceGauge x:Name="MemoryGauge" Title="Memory" Fill="{DynamicResource MemoryStroke}" /></Border>
      <Border Classes="card" Padding="8" Margin="0,0,8,8"><local:ResourceGauge x:Name="NetworkGauge" Title="Network" Fill="{DynamicResource NetworkStroke}" /></Border>
      <Border Classes="card" Padding="8" Margin="0,0,0,8"><local:ResourceGauge x:Name="StorageGauge" Title="Storage" Fill="{DynamicResource StorageStroke}" /></Border>
    </UniformGrid>
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16" MinHeight="32">
      <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Network" Classes="label" VerticalAlignment="Center" /><ComboBox x:Name="NetworkAdapter" AutomationProperties.Name="Network interface" HorizontalAlignment="Stretch" MaxWidth="340" /></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="Data volume · available" Classes="label" VerticalAlignment="Center" /><TextBlock x:Name="DiskValue" Text="—" VerticalAlignment="Center" /><TextBlock x:Name="DiskTotal" Classes="label" FontSize="11" VerticalAlignment="Center" /></StackPanel>
    </Grid>
    <Border Grid.Row="2" Classes="card" Padding="12">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Resource history" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" x:Name="ChartModeBox" SelectedIndex="0" AutomationProperties.Name="Chart layout">
            <ComboBoxItem Content="Overlay" /><ComboBoxItem Content="Small multiples" /><ComboBoxItem Content="Heatmap" /><ComboBoxItem Content="Focus" />
          </ComboBox>
          <ComboBox Grid.Column="2" x:Name="FocusMetricBox" SelectedIndex="0" AutomationProperties.Name="Focus metric" IsVisible="False">
            <ComboBoxItem Content="CPU" /><ComboBoxItem Content="Memory" /><ComboBoxItem Content="Network" /><ComboBoxItem Content="Storage" />
          </ComboBox>
          <ComboBox Grid.Column="3" x:Name="HistoryRange" SelectedIndex="0" AutomationProperties.Name="History range">
            <ComboBoxItem Content="2 minutes" /><ComboBoxItem Content="10 minutes" /><ComboBoxItem Content="30 minutes" /><ComboBoxItem Content="60 minutes" />
          </ComboBox>
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="4">
          <UniformGrid Columns="4">
            <CheckBox x:Name="CpuVisible" Content="CPU · 0–100%" Foreground="{DynamicResource CpuText}" IsChecked="True" FontSize="11" />
            <CheckBox x:Name="MemoryVisible" Content="Memory · 0–100%" Foreground="{DynamicResource MemoryText}" IsChecked="True" FontSize="11" />
            <CheckBox x:Name="NetworkVisible" Content="Network · bytes/s" Foreground="{DynamicResource NetworkText}" IsChecked="True" FontSize="11" />
            <CheckBox x:Name="StorageVisible" Content="Storage · bytes/s" Foreground="{DynamicResource StorageText}" IsChecked="True" FontSize="11" />
          </UniformGrid>
          <local:CpuChart Grid.Row="1" x:Name="Chart" Height="180" />
        </Grid>
        <StackPanel Grid.Row="2" Spacing="6">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button x:Name="LiveMode" Content="Live" />
            <Button Grid.Column="1" x:Name="CaptureMode" Content="Capture" />
            <TextBlock Grid.Column="2" Text="Click the chart to inspect" Classes="label" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
            <Button Grid.Column="3" x:Name="ExportResources" Content="Export resources" />
            <Button Grid.Column="4" x:Name="ExportProcesses" Content="Export processes" />
          </Grid>
          <Expander Header="Automatic capture reports" HorizontalAlignment="Stretch" Padding="0">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button x:Name="ConfigureCaptures" Content="Automatic captures…" />
            <ComboBox Grid.Column="1" x:Name="CapturesList" PlaceholderText="Saved automatic captures" AutomationProperties.Name="Automatic captures" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" x:Name="OpenCaptureReport" Content="Open report" IsEnabled="False" />
            <Button Grid.Column="3" x:Name="CopyCapture" Content="Copy capture" />
          </Grid>
          </Expander>
          <TextBlock x:Name="CaptureStatus" Text="Live · recording" Classes="label" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
      </Grid>
    </ScrollViewer>
    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext" Focusable="True" Background="{DynamicResource MacGridBrush}" AutomationProperties.Name="Resize dashboard and data panes" />
    <Border Grid.Row="3" Classes="card" MinHeight="300" Padding="12">
      <TabControl x:Name="DataTabs">
        <TabItem Header="Processes">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6">
        <Grid ColumnDefinitions="*,240,160" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock x:Name="ProcessCountLabel" Text="Establishing baselines…" Classes="label" FontSize="12" />
          </StackPanel>
          <TextBox Grid.Column="1" x:Name="ProcessSearchBox" PlaceholderText="Search name or PID"
                   AutomationProperties.Name="Search processes" VerticalAlignment="Center" />
          <ComboBox Grid.Column="2" x:Name="ProcessSortBox" SelectedIndex="0"
                    AutomationProperties.Name="Sort processes" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <ComboBoxItem Content="CPU usage" />
            <ComboBoxItem Content="Resident memory" />
            <ComboBoxItem Content="Threads" />
            <ComboBoxItem Content="Disk I/O" />
          </ComboBox>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
          <CheckBox x:Name="GroupProcesses" Content="Grouped" />
          <CheckBox x:Name="PinnedOnly" Content="Pinned only" />
          <Button x:Name="PinSelection" Content="Pin selected" IsEnabled="False" />
          <TextBlock Text="30s trend · selected metric · local scale" Classes="label" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,80,100,120,80,100,90" Margin="10,0,10,0">
          <TextBlock Text="Name" Classes="label" />
          <TextBlock Grid.Column="1" Text="PID" Classes="label" />
          <TextBlock Grid.Column="2" Text="CPU · avg 5s" Classes="label" />
          <TextBlock Grid.Column="3" x:Name="ResidentHeader" Text="Resident" Classes="label" />
          <TextBlock Grid.Column="4" Text="Threads" Classes="label" />
          <TextBlock Grid.Column="5" Text="Disk I/O · 5s" Classes="label" />
          <TextBlock Grid.Column="6" Text="Trend" Classes="label" />
        </Grid>
        <Grid Grid.Row="3">
          <ListBox x:Name="ProcessList" Background="Transparent" BorderThickness="0"
                   AutomationProperties.Name="Observed processes">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:ProcessRow">
                <Grid ColumnDefinitions="*,80,100,120,80,100,90" Margin="0,3" ToolTip.Tip="{Binding Path}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <TextBlock Text="{Binding Pin}" Classes="pinMetric" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <TextBlock Grid.Column="1" Text="{Binding Pid}" />
                  <TextBlock Grid.Column="2" Text="{Binding Cpu}" Classes="cpuMetric" />
                  <TextBlock Grid.Column="3" Text="{Binding Resident}" />
                  <TextBlock Grid.Column="4" Text="{Binding Threads}" />
                  <TextBlock Grid.Column="5" Text="{Binding Io}" />
                  <local:ProcessSparkline Grid.Column="6" Trail="{Binding Trail}" Height="20" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyProcessLabel" Text="Waiting for process readings…" Classes="label"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Grid.Row="4" Spacing="6">
          <StackPanel x:Name="ProcessActionsPanel" Orientation="Horizontal" Spacing="10" IsVisible="False">
            <Button x:Name="ShowProperties" Content="Properties" />
            <Button x:Name="CopyProcessDetails" Content="Copy details" />
            <Button x:Name="RevealExecutable" Content="Reveal in Finder" />
            <Button x:Name="EndProcess" Content="End process…" />
          </StackPanel>
          <TextBlock x:Name="SelectionLabel" Text="Select a process to inspect its lifetime and path."
                     Classes="label" FontSize="12" TextWrapping="Wrap" MaxHeight="40" />
        </StackPanel>
      </Grid>
        </TabItem>
        <TabItem Header="Usage">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,220,150,Auto,Auto" ColumnSpacing="10">
              <TextBlock Text="Session usage" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="UsageSearch" PlaceholderText="Search name or path" AutomationProperties.Name="Search usage" />
              <ComboBox Grid.Column="2" x:Name="UsageSortBox" SelectedIndex="0" AutomationProperties.Name="Sort usage" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="CPU time" /><ComboBoxItem Content="Disk I/O" /><ComboBoxItem Content="Last active" />
              </ComboBox>
              <Button Grid.Column="3" x:Name="ResetUsage" Content="Reset" />
              <Button Grid.Column="4" x:Name="ExportUsage" Content="Export CSV" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,100,90,120,110,100" Margin="10,0">
              <TextBlock Text="Executable" Classes="label" />
              <TextBlock Grid.Column="1" Text="CPU time" Classes="label" />
              <TextBlock Grid.Column="2" Text="Busy share" Classes="label" />
              <TextBlock Grid.Column="3" Text="Disk I/O" Classes="label" />
              <TextBlock Grid.Column="4" Text="Running / seen" Classes="label" />
              <TextBlock Grid.Column="5" Text="Last active" Classes="label" />
            </Grid>
            <ListBox Grid.Row="2" x:Name="UsageList" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Session usage totals">
              <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:UsageRow">
                  <Grid ColumnDefinitions="*,100,90,120,110,100" Margin="0,3" ToolTip.Tip="{Binding Path}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Cpu}" Classes="cpuMetric" />
                    <TextBlock Grid.Column="2" Text="{Binding Share}" />
                    <TextBlock Grid.Column="3" Text="{Binding DiskIo}" />
                    <TextBlock Grid.Column="4" Text="{Binding Processes}" />
                    <TextBlock Grid.Column="5" Text="{Binding LastActive}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" x:Name="UsageStatus" Classes="label" FontSize="12" TextWrapping="Wrap" />
          </Grid>
        </TabItem>
        <TabItem Header="Jobs"><local:LaunchdView x:Name="JobsView" /></TabItem>
      </TabControl>
    </Border>
    <StackPanel Grid.Row="4" Spacing="6">
      <TextBlock x:Name="StatusLabel" Text="Starting native collector…" Classes="label" FontSize="11" TextWrapping="Wrap" />
      <TextBlock Text="CPU is a share of total machine capacity · — means unavailable · resident memory includes shared pages"
                 Classes="label" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
  </Grid>
</Window>
