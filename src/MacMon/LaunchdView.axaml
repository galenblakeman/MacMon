<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MacMon" x:Class="MacMon.LaunchdView">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="4">
    <Border Classes="sectionHeader"><WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,8,4"><TextBlock Text="{local:Loc &quot;Top&quot;}" Classes="toolbarLabel" /><ComboBox x:Name="JobLimit" Width="54" Classes="rankingChoice" AutomationProperties.Name="{local:Loc &quot;Job row limit&quot;}" /><TextBlock Text="{local:Loc &quot;jobs by&quot;}" Classes="toolbarLabel" /><ComboBox x:Name="JobSort" Width="96" Classes="rankingChoice" SelectedIndex="0" AutomationProperties.Name="{local:Loc &quot;Sort jobs&quot;}"><ComboBoxItem Content="{local:Loc &quot;Label&quot;}" /><ComboBoxItem Content="{local:Loc &quot;Running first&quot;}" /><ComboBoxItem Content="{local:Loc &quot;PID&quot;}" /><ComboBoxItem Content="{local:Loc &quot;CPU&quot;}" /><ComboBoxItem Content="{local:Loc &quot;Memory&quot;}" /><ComboBoxItem Content="{local:Loc &quot;Disk I/O&quot;}" /></ComboBox></StackPanel>
      <TextBox x:Name="JobSearch" Width="190" PlaceholderText="{local:Loc &quot;Search label, PID or process&quot;}" AutomationProperties.Name="{local:Loc &quot;Search jobs&quot;}" Margin="0,0,8,4" />
      <ComboBox x:Name="JobFilter" Width="120" SelectedIndex="0" AutomationProperties.Name="{local:Loc &quot;Filter jobs&quot;}" Margin="0,0,0,4"><ComboBoxItem Content="{local:Loc &quot;All loaded&quot;}" /><ComboBoxItem Content="{local:Loc &quot;Running&quot;}" /><ComboBoxItem Content="{local:Loc &quot;Not running&quot;}" /></ComboBox>
    </WrapPanel></Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,140,100,65,95,85" Margin="6,0,18,0">
      <TextBlock Text="{local:Loc &quot;Job / process&quot;}" Classes="columnLabel" /><TextBlock Grid.Column="1" Text="{local:Loc &quot;History&quot;}" Classes="columnLabel" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="{local:Loc &quot;Status&quot;}" Classes="columnLabel" /><TextBlock x:Name="JobCpuHeader" Grid.Column="3" Text="{local:Loc &quot;CPU&quot;}" Classes="columnLabel" HorizontalAlignment="Right" /><TextBlock Grid.Column="4" Text="{local:Loc &quot;Memory&quot;}" Classes="columnLabel" HorizontalAlignment="Right" /><TextBlock Grid.Column="5" Text="{local:Loc &quot;Disk MiB/s&quot;}" Classes="columnLabel" HorizontalAlignment="Right" />
    </Grid>
    <Grid Grid.Row="2">
      <ListBox x:Name="JobList" Classes="dataRows" AutoScrollToSelectedItem="False" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{local:Loc &quot;Loaded launchd jobs&quot;}">
        <ListBox.ItemTemplate><DataTemplate x:DataType="local:LaunchdRow"><Border Classes="dataRow"><Grid ColumnDefinitions="*,140,100,65,95,85" ToolTip.Tip="{Binding Description}">
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ProcessDescription}" Classes="label" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel>
          <local:ProcessSparkline Grid.Column="1" Trail="{Binding Trail}" Height="24" Margin="6,0" />
          <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="3" Text="{Binding Cpu}" Classes="cpuMetric" VerticalAlignment="Center" HorizontalAlignment="Right" /><TextBlock Grid.Column="4" Text="{Binding Resident}" VerticalAlignment="Center" HorizontalAlignment="Right" /><TextBlock Grid.Column="5" Text="{Binding Io}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="JobEmpty" Text="{local:Loc &quot;Choose Refresh to read loaded jobs.&quot;}" Classes="label" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap" />
    </Grid>
<Border Grid.Row="3" Classes="actionBar"><Grid ColumnDefinitions="4,*,Auto">
                <Border Background="{DynamicResource CpuStroke}" CornerRadius="3,0,0,3" />
                <local:ActionBarLayout Grid.Column="1" Margin="14,6,6,6">
                  <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="JobSelectionName" Text="{local:Loc &quot;Select a job&quot;}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="JobScope" Text="{local:Loc &quot;Current bootstrap context · read only&quot;}" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsChecked, ElementName=ShowJobActions}"><Button x:Name="JobDetails" local:ButtonIcon.Kind="Info" Content="{local:Loc &quot;Properties&quot;}" IsEnabled="False" /><Button x:Name="CopyJob" local:ButtonIcon.Kind="Copy" Content="{local:Loc &quot;Copy details&quot;}" IsEnabled="False" /><Border Classes="actionDivider" /><Button x:Name="RefreshJobs" local:ButtonIcon.Kind="Live" Content="{local:Loc &quot;Refresh&quot;}" /></WrapPanel>
                </local:ActionBarLayout>
                <ToggleButton Grid.Column="2" x:Name="ShowJobActions" local:ButtonIcon.Kind="ChevronDown" IsChecked="True" Classes="actionCollapse" AutomationProperties.Name="{local:Loc &quot;Show or hide actions&quot;}" ToolTip.Tip="{local:Loc &quot;Show or hide actions&quot;}" />
              </Grid></Border>
    <TextBlock x:Name="JobStatus" IsVisible="False" />
  </Grid>
</UserControl>
