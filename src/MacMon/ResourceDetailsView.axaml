<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MacMon" x:Class="MacMon.ResourceDetailsView" Width="340" MaxHeight="500"
             Foreground="{DynamicResource MacTextBrush}">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="5">
      <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold" />
      <TextBlock x:Name="DetailStatus" Classes="label" FontSize="12" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Margin="0,0,8,0">
        <TextBlock x:Name="Definition" Classes="label" FontSize="12" TextWrapping="Wrap" />
        <ItemsControl x:Name="DetailRows">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:ResourceDetailRow">
              <Grid ColumnDefinitions="145,*" ColumnSpacing="12" Margin="0,5">
                <TextBlock Text="{Binding Label}" Classes="label" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="— means unavailable. Readings stay live while the chart is in Capture mode." Classes="label" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="2" x:Name="CloseDetails" Content="Close" HorizontalAlignment="Right" />
  </Grid>
</UserControl>
