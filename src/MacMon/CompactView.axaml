<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MacMon" xmlns:chrome="using:Avalonia.Controls.Chrome" x:Class="MacMon.CompactView">
  <Grid Margin="12,0,12,4" RowDefinitions="Auto,*,Auto" RowSpacing="6">
    <Grid x:Name="CompactTitleActions" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6" Height="36" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <TextBlock Text="MacMon" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Button Grid.Column="1" x:Name="CompactInfo" Content="ⓘ Info" Classes="titleAction" />
      <Button Grid.Column="2" x:Name="CompactSettings" Content="⚙ Settings" Classes="titleAction" ToolTip.Tip="Settings (⌘,)" />
      <Button Grid.Column="3" x:Name="CompactExport" Content="↥ Export" Classes="titleAction"><Button.Flyout><Flyout Placement="Bottom"><StackPanel Spacing="6"><Button x:Name="CompactResourcesCsv" Content="Resource history CSV…" /><Button x:Name="CompactProcessesCsv" Content="Retained processes CSV…" /><Button x:Name="CompactUsageCsv" Content="Session usage CSV…" /></StackPanel></Flyout></Button.Flyout></Button>
      <Button Grid.Column="5" x:Name="ExpandView" Content="▱ Full view" Classes="titleAction" ToolTip.Tip="Full view (⌘⇧M or Escape)" />
      <ToggleButton Grid.Column="6" x:Name="CompactOnTop" Content="↟ Always on top" Classes="titleAction" />
    </Grid>
    <UniformGrid Grid.Row="1" Columns="4">
      <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="8"><local:ResourceGauge x:Name="Cpu" Title="CPU" IsCompact="True" Fill="{DynamicResource CpuText}" /></Border>
      <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="8"><local:ResourceGauge x:Name="Memory" Title="Memory" IsCompact="True" Fill="{DynamicResource MemoryText}" /></Border>
      <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="8"><local:ResourceGauge x:Name="Storage" Title="Storage" IsCompact="True" Fill="{DynamicResource StorageText}" /></Border>
      <Border Padding="8"><local:ResourceGauge x:Name="Network" Title="Network" IsCompact="True" Fill="{DynamicResource NetworkText}" /></Border>
    </UniformGrid>
    <TextBlock Grid.Row="2" x:Name="LiveStatus" Text="Waiting for live readings…" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
