<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MacMon" xmlns:chrome="using:Avalonia.Controls.Chrome" x:Class="MacMon.CompactView">
  <Grid Margin="12,0,12,4" RowDefinitions="Auto,*,Auto" RowSpacing="6">
    <Grid x:Name="CompactTitleActions" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6" Height="36" Background="{DynamicResource MacChromeBrush}" chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <TextBlock Text="{local:Loc &quot;MacMon&quot;}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Button Grid.Column="1" x:Name="CompactInfo" Content="{local:TitleButtonContent Info, Info}" AutomationProperties.Name="{local:Loc &quot;Info&quot;}" Classes="titleAction" />
      <Button Grid.Column="2" x:Name="CompactSettings" Content="{local:TitleButtonContent Settings, Settings}" AutomationProperties.Name="{local:Loc &quot;Settings&quot;}" Classes="titleAction" ToolTip.Tip="{local:Loc &quot;Settings (⌘,)&quot;}" />
      <Button Grid.Column="3" x:Name="CompactExport" Content="{local:TitleButtonContent Download, Export}" AutomationProperties.Name="{local:Loc &quot;Export&quot;}" Classes="titleAction" />
      <Button Grid.Column="5" x:Name="ExpandView" Content="{local:TitleButtonContent Expand, Full view}" AutomationProperties.Name="{local:Loc &quot;Full view&quot;}" Classes="titleAction" ToolTip.Tip="{local:Loc &quot;Full view (⌘⇧M or Escape)&quot;}" />
      <ToggleButton Grid.Column="6" x:Name="CompactOnTop" Content="{local:TitleButtonContent AlwaysOnTop, Always on top}" AutomationProperties.Name="{local:Loc &quot;Always on top&quot;}" Classes="titleAction" />
    </Grid>
    <UniformGrid x:Name="ResourceCards" Grid.Row="1" Columns="5">
      <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,8"><local:ResourceGauge x:Name="Cpu" Title="CPU" IsCompact="True" Fill="{DynamicResource CpuText}" /></Border>
      <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,8"><local:ResourceGauge x:Name="Memory" Title="Memory" IsCompact="True" Fill="{DynamicResource MemoryText}" /></Border>
      <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,8"><local:ResourceGauge x:Name="Storage" Title="Disk" IsCompact="True" Fill="{DynamicResource StorageText}" /></Border>
      <Border x:Name="SecondDiskCard" IsVisible="False" BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,8"><local:ResourceGauge x:Name="SecondDisk" Title="Disk 2" Fill="{DynamicResource SecondDiskStroke}" IsCompact="True" /></Border>
      <Border BorderBrush="{DynamicResource MacGridBrush}" BorderThickness="0,0,1,0" Padding="5,8"><local:ResourceGauge x:Name="Network" Title="Network" IsCompact="True" Fill="{DynamicResource NetworkText}" /></Border>
      <Border Padding="5,8"><local:ResourceGauge x:Name="Gpu" Title="GPU" Fill="{DynamicResource GpuStroke}" IsCompact="True" /></Border>
    </UniformGrid>
    <TextBlock Grid.Row="2" x:Name="LiveStatus" Text="{local:Loc &quot;Waiting for live readings…&quot;}" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
