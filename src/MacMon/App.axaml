<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MacMon" xmlns:chrome="using:Avalonia.Controls.Chrome" x:Class="MacMon.App" Name="MacMon" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MacWindowBrush" Color="#0E1721" />
          <SolidColorBrush x:Key="MacCardBrush" Color="#17222E" />
          <SolidColorBrush x:Key="MacTextBrush" Color="#F2F5F8" />
          <SolidColorBrush x:Key="MacMutedBrush" Color="#9BAAB9" />
          <SolidColorBrush x:Key="MacGridBrush" Color="#394959" />
          <SolidColorBrush x:Key="MacMarkerBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MacWindowBrush" Color="#EDF2F7" />
          <SolidColorBrush x:Key="MacCardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MacTextBrush" Color="#17222E" />
          <SolidColorBrush x:Key="MacMutedBrush" Color="#4D5E70" />
          <SolidColorBrush x:Key="MacGridBrush" Color="#CDD7E2" />
          <SolidColorBrush x:Key="MacMarkerBrush" Color="#17222E" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource MacWindowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
    </Style>
    <Style Selector="TextBlock.toolbarLabel"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="TextBlock.columnLabel"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource MacMutedBrush}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="ComboBox"><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="6,3" /></Style>
    <Style Selector="TextBox"><Setter Property="VerticalContentAlignment" Value="Bottom" /><Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="6,3" /></Style>
    <Style Selector="ComboBoxItem"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="ComboBox.rankingChoice"><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="3,2" /></Style>
    <Style Selector="Button.titleAction, ToggleButton.titleAction"><Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User" /><Setter Property="Background" Value="Transparent" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="6,4" /></Style>
    <Style Selector="Button.chip, RadioButton.chip"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="7,3" /><Setter Property="MinHeight" Value="26" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="RadioButton.chip"><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter></Style>
    <Style Selector="RadioButton.chip:checked, Button.chip.active, ToggleButton.titleAction:checked"><Setter Property="Background" Value="{DynamicResource MacGridBrush}" /></Style>
    <Style Selector="Border.sectionHeader"><Setter Property="Background" Value="{DynamicResource MacHeaderBrush}" /><Setter Property="Padding" Value="6,5,6,1" /></Style>
    <Style Selector="Border.actionBar"><Setter Property="Background" Value="{DynamicResource MacHeaderBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource MacGridBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /><Setter Property="MinHeight" Value="54" /></Style>
    <Style Selector="Border.actionBar Button"><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="12,2" /><Setter Property="MinWidth" Value="80" /><Setter Property="Height" Value="28" /></Style>
    <Style Selector="Border.actionDivider"><Setter Property="Width" Value="1" /><Setter Property="Height" Value="24" /><Setter Property="Margin" Value="4,0,12,0" /><Setter Property="Background" Value="{DynamicResource MacGridBrush}" /></Style>
    <Style Selector="ToggleButton.actionCollapse"><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter><Setter Property="ContentTemplate" Value="{x:Null}" /><Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="4,0,8,0" /><Setter Property="FontSize" Value="18" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="AutomationProperties.Name" Value="{local:Loc &quot;Show or hide actions&quot;}" /></Style>
    <Style Selector="ToggleButton.actionCollapse, ToggleButton.actionCollapse:checked"><Setter Property="Background" Value="{DynamicResource MacCardBrush}" /><Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource MacGridBrush}" /></Style>
    <Style Selector="ToggleButton.actionCollapse:pointerover"><Setter Property="Background" Value="{DynamicResource MacChromeBrush}" /></Style>
    <Style Selector="ToggleButton.actionCollapse:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource MacTextBrush}" /></Style>
    <Style Selector="Button.dangerAction"><Setter Property="BorderBrush" Value="#964E4E" /></Style>
    <Style Selector="Border.dataRow"><Setter Property="BorderBrush" Value="{DynamicResource MacGridBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="6,3" /><Setter Property="MinHeight" Value="42" /></Style>
    <Style Selector="Button.rowPin"><Setter Property="MinWidth" Value="0" /><Setter Property="MaxWidth" Value="28" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="2" /><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector="Button, ToggleButton, RadioButton.chip">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ContentTemplate"><local:ButtonLabelTemplate /></Setter>
    </Style>
    <Style Selector="RadioButton.chip"><Setter Property="ContentTemplate" Value="{x:Null}" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="8,4" /><Setter Property="MinHeight" Value="28" /></Style>
    <Style Selector="Button.tableHeader">
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MacMutedBrush}" />
      <Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="ListBox.dataRows"><Setter Property="FontSize" Value="12" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" /><Setter Property="ScrollViewer.AllowAutoHide" Value="False" /></Style>
    <Style Selector="ListBox.dataRows ScrollBar:vertical"><Setter Property="Width" Value="12" /><Setter Property="MinWidth" Value="12" /></Style>
    <Style Selector="Button.numericHeader"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Right" /></Style>
    <Style Selector="ListBox.dataRows ListBoxItem"><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="42" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="10,6" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource MacMutedBrush}" /></Style>
    <Style Selector="TextBlock.cpuMetric"><Setter Property="Foreground" Value="{DynamicResource CpuText}" /></Style>
    <Style Selector="TextBlock.pinMetric"><Setter Property="Foreground" Value="{DynamicResource MemoryText}" /></Style>
    <Style Selector="ListBoxItem:selected TextBlock.cpuMetric, ListBoxItem:selected TextBlock.pinMetric">
      <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource MacCardBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="local|ResourceGauge">
      <Setter Property="Foreground" Value="{DynamicResource MacTextBrush}" />
      <Setter Property="GaugeStyle" Value="{DynamicResource ResourceGaugeStyle}" />
      <Setter Property="Track" Value="{DynamicResource MacGaugeTrackBrush}" />
      <Setter Property="Marker" Value="{DynamicResource MacMarkerBrush}" />
    </Style>
    <Style Selector="local|CpuChart">
      <Setter Property="PlotBrush" Value="{DynamicResource MacPlotBrush}" />
      <Setter Property="CpuBrush" Value="{DynamicResource CpuStroke}" />
      <Setter Property="MemoryBrush" Value="{DynamicResource MemoryStroke}" />
      <Setter Property="NetworkBrush" Value="{DynamicResource NetworkStroke}" />
      <Setter Property="SecondDiskBrush" Value="{DynamicResource SecondDiskStroke}" />
      <Setter Property="GpuBrush" Value="{DynamicResource GpuStroke}" />
      <Setter Property="StorageBrush" Value="{DynamicResource StorageStroke}" />
      <Setter Property="GridBrush" Value="{DynamicResource MacGridBrush}" />
      <Setter Property="MarkerBrush" Value="{DynamicResource MacMarkerBrush}" />
    </Style>
    <Style Selector="local|ProcessSparkline"><Setter Property="Stroke" Value="{DynamicResource CpuStroke}" /></Style>
  </Application.Styles>
</Application>
